# AbstractContainerMenu
# `slots` (NonNullList) and `containerId` are already public, and the screen
# fields below are protected, so only genuinely private members are widened.
# Field names use the 26.1 spellings: quickcraftSlots / quickcraftType /
# quickcraftStatus (the old quickCraft* names no longer exist).
accessible	field	net/minecraft/world/inventory/AbstractContainerMenu	quickcraftSlots	Ljava/util/Set;
accessible	field	net/minecraft/world/inventory/AbstractContainerMenu	quickcraftType	I
accessible	field	net/minecraft/world/inventory/AbstractContainerMenu	quickcraftStatus	I
accessible	method	net/minecraft/world/inventory/AbstractContainerMenu	tryItemClickBehaviourOverride	(Lnet/minecraft/world/entity/player/Player;Lnet/minecraft/world/inventory/ClickAction;Lnet/minecraft/world/inventory/Slot;Lnet/minecraft/world/item/ItemStack;Lnet/minecraft/world/item/ItemStack;)Z

# AbstractContainerScreen
# `findSlot` was renamed; the slot-under-cursor lookup is now getHoveredSlot.
accessible	method	net/minecraft/client/gui/screens/inventory/AbstractContainerScreen	getHoveredSlot	(DD)Lnet/minecraft/world/inventory/Slot;

# CreativeModeTab display item types are protected nested classes in 26.1.2
accessible	class	net/minecraft/world/item/CreativeModeTab$Output
accessible	class	net/minecraft/world/item/CreativeModeTab$ItemDisplayParameters

# MenuScreens: 26.1 makes the screen registry private and Fabric exposes no
# alternative, so the map and its constructor interface are widened to let the
# mod register its container screens.
accessible	class	net/minecraft/client/gui/screens/MenuScreens$ScreenConstructor
accessible	field	net/minecraft/client/gui/screens/MenuScreens	SCREENS	Ljava/util/Map;

# LivingEntityRenderer#addLayer is protected, and Fabric exposes no feature-layer
